---
import { siteConfig } from '../content/site';
---

<section class="section-gap bg-aged-paper" id="pricing">
  <div class="container">

    <!-- Header -->
    <div class="flex flex-col gap-4 mb-12 md:mb-16 max-w-xl">
      <p class="eyebrow reveal">Форматы и стоимость</p>
      <h2
        class="font-serif font-medium text-ink reveal"
        style="font-size: clamp(32px, 4vw, 45px); letter-spacing: 0; line-height: 1.1;"
      >
        Выберите удобный <em style="font-style: italic; font-weight: 400;">формат</em>
      </h2>
    </div>

    <!-- Pricing grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {siteConfig.pricing.map((plan, index) => (
        <article
          class={`flex flex-col gap-5 rounded-card p-6 md:p-8 reveal ${
            plan.featured
              ? 'bg-parchment border-2 border-accent relative'
              : 'bg-parchment border border-warm-taupe'
          }`}
          style={`transition-delay: ${index * 70}ms;`}
        >
          <!-- Featured badge -->
          {plan.featured && plan.badge && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
              <span
                class="eyebrow bg-accent text-parchment rounded-pill px-4 py-1.5 whitespace-nowrap"
                style="font-size: 11px;"
              >
                {plan.badge}
              </span>
            </div>
          )}

          {/* Extra top padding for featured card to account for badge */}
          <div class={plan.featured ? 'mt-2' : ''}>
            <!-- Plan title -->
            <p
              class="eyebrow mb-1"
            >
              {plan.subtitle}
            </p>
            <h3
              class="font-serif font-medium text-ink"
              style="font-size: 26px; letter-spacing: 0; line-height: 1.2;"
            >
              {plan.title}
            </h3>
          </div>

          <!-- Duration -->
          <p
            class="text-graphite"
            style="font-size: 13px; letter-spacing: -0.023em; line-height: 1.4;"
          >
            {plan.duration}
          </p>

          <!-- Price -->
          <div class="flex flex-col gap-0.5">
            <div class="flex items-baseline gap-1">
              <span
                class="font-serif font-medium text-ink"
                style="font-size: 40px; letter-spacing: 0; line-height: 1;"
              >
                {plan.price.toLocaleString('ru-RU')}
              </span>
              <span
                class="text-graphite"
                style="font-size: 18px; letter-spacing: -0.023em;"
              >
                {plan.currency}
              </span>
            </div>
            {plan.pricePerSession && (
              <p
                class="text-graphite"
                style="font-size: 13px; letter-spacing: -0.023em;"
              >
                {plan.pricePerSession.toLocaleString('ru-RU')} {plan.currency} за сессию
              </p>
            )}
          </div>

          <!-- Description -->
          <p
            class="text-charcoal flex-grow"
            style="font-size: 14px; line-height: 1.55; letter-spacing: -0.023em;"
          >
            {plan.description}
          </p>

          <!-- CTA -->
          <a
            href="#contact"
            class={plan.featured ? 'btn-primary text-center' : 'btn-outline text-center'}
          >
            Записаться
          </a>
        </article>
      ))}
    </div>

    <!-- Cancellation notice -->
    <p
      class="mt-6 text-center text-graphite reveal"
      style="font-size: 13px; letter-spacing: -0.023em; line-height: 1.5;"
    >
      Отмена или перенос бесплатно не позднее чем за 24 часа до встречи.
    </p>

  </div>
</section>
