---
import { siteConfig } from '../content/site';

// SVG icon map — outline style, 1.5px stroke
const icons: Record<string, string> = {
  heart: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
  flame: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>`,
  users: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  compass: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>`,
  moon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>`,
  leaf: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>`,
};
---

<section class="section-gap bg-parchment" id="services">
  <div class="container">
    <!-- Header -->
    <div class="flex flex-col gap-4 mb-12 md:mb-16 max-w-2xl">
      <p class="eyebrow reveal">С чем я работаю</p>
      <h2
        class="font-serif font-medium text-ink reveal"
        style="font-size: clamp(32px, 4vw, 45px); letter-spacing: 0; line-height: 1.1;"
      >
        Темы, с которыми <em style="font-style: italic; font-weight: 400;">приходят</em>
      </h2>
    </div>

    <!-- Cards grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
      {siteConfig.services.map((service, index) => (
        <article
          class="card flex flex-col gap-4 reveal hover:shadow-card transition-shadow duration-300"
          style={`transition-delay: ${index * 60}ms;`}
        >
          <!-- Icon -->
          <div class="text-accent w-6 h-6" set:html={icons[service.icon] || icons.leaf} />

          <!-- Content -->
          <div class="flex flex-col gap-2">
            <h3
              class="font-serif font-medium text-ink"
              style="font-size: 22px; letter-spacing: 0; line-height: 1.2;"
            >
              {service.title}
            </h3>
            <p
              class="text-charcoal"
              style="font-size: 15px; line-height: 1.55; letter-spacing: -0.023em;"
            >
              {service.description}
            </p>
          </div>

          <!-- Tags -->
          {service.tags && service.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-auto pt-2">
              {service.tags.map((tag) => (
                <span
                  class="bg-parchment text-graphite rounded-pill px-3 py-1"
                  style="font-size: 12px; letter-spacing: -0.023em; line-height: 1.4;"
                >
                  {tag}
                </span>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>

    <!-- Additional tags inline list -->
    <div class="mt-10 md:mt-12 reveal">
      <p
        class="text-graphite"
        style="font-size: 14px; letter-spacing: -0.023em; line-height: 1.8;"
      >
        Также работаю с:&nbsp;
        {siteConfig.additionalTags.map((tag, index) => (
          <>
            <span class="text-charcoal">{tag}</span>
            {index < siteConfig.additionalTags.length - 1 && (
              <span class="text-accent mx-2" aria-hidden="true">&middot;</span>
            )}
          </>
        ))}
      </p>
    </div>
  </div>
</section>
