---
import { siteConfig } from '../content/site';
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-parchment border-b border-transparent transition-all duration-300"
>
  <div class="container flex items-center justify-between h-16 md:h-18">
    <!-- Logo -->
    <a
      href="/"
      class="font-serif text-xl md:text-2xl font-medium text-ink hover:text-accent transition-colors"
      style="letter-spacing: 0; line-height: 1.1;"
      aria-label="На главную"
    >
      {siteConfig.name}
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Основная навигация">
      <a href="#about" class="btn-ghost text-sm">Обо мне</a>
      <a href="#services" class="btn-ghost text-sm">С чем работаю</a>
      <a href="#pricing" class="btn-ghost text-sm">Форматы</a>
      <a href="#faq" class="btn-ghost text-sm">FAQ</a>
    </nav>

    <!-- CTA + Burger -->
    <div class="flex items-center gap-3">
      <a href="#contact" class="btn-primary text-sm hidden md:inline-flex">
        Записаться
      </a>
      <button
        id="burger-btn"
        class="md:hidden flex flex-col gap-1.5 p-2 rounded-nav hover:bg-aged-paper transition-colors"
        aria-label="Открыть меню"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="burger-line block w-5 h-0.5 bg-ink transition-all duration-300"></span>
        <span class="burger-line block w-5 h-0.5 bg-ink transition-all duration-300"></span>
        <span class="burger-line block w-5 h-0.5 bg-ink transition-all duration-300"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-parchment border-t border-warm-taupe"
    aria-hidden="true"
  >
    <nav class="container py-4 flex flex-col gap-1" aria-label="Мобильная навигация">
      <a href="#about" class="btn-ghost text-base w-full text-left rounded-nav">Обо мне</a>
      <a href="#services" class="btn-ghost text-base w-full text-left rounded-nav">С чем работаю</a>
      <a href="#pricing" class="btn-ghost text-base w-full text-left rounded-nav">Форматы</a>
      <a href="#faq" class="btn-ghost text-base w-full text-left rounded-nav">FAQ</a>
      <div class="pt-2 border-t border-warm-taupe mt-2">
        <a href="#contact" class="btn-primary w-full text-center">
          Записаться
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const burgerBtn = document.getElementById('burger-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  // Sticky border on scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      header?.classList.add('border-warm-taupe');
      header?.classList.remove('border-transparent');
    } else {
      header?.classList.remove('border-warm-taupe');
      header?.classList.add('border-transparent');
    }
  });

  // Mobile menu toggle
  burgerBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('hidden') === false;
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      burgerBtn.setAttribute('aria-expanded', 'false');
      mobileMenu?.setAttribute('aria-hidden', 'true');
    } else {
      mobileMenu?.classList.remove('hidden');
      burgerBtn.setAttribute('aria-expanded', 'true');
      mobileMenu?.setAttribute('aria-hidden', 'false');
    }
  });

  // Close menu on anchor link click
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      burgerBtn?.setAttribute('aria-expanded', 'false');
      mobileMenu.setAttribute('aria-hidden', 'true');
    });
  });
</script>
