---
import { siteConfig } from '../content/site';
---

<section class="section-gap bg-aged-paper" id="approach">
  <div class="container">
    <div class="grid md:grid-cols-2 gap-12 md:gap-16">

      <!-- Left: Approach text -->
      <div class="flex flex-col gap-6">
        <p class="eyebrow reveal">Подход и образование</p>

        <h2
          class="font-serif font-medium text-ink reveal"
          style="font-size: clamp(32px, 4vw, 45px); letter-spacing: 0; line-height: 1.1;"
        >
          Как я <em style="font-style: italic; font-weight: 400;">работаю</em>
        </h2>

        <p
          class="text-charcoal reveal"
          style="font-size: 16px; line-height: 1.65; letter-spacing: -0.023em;"
        >
          {siteConfig.approach.text}
        </p>

        <p
          class="text-graphite reveal"
          style="font-size: 14px; line-height: 1.6; letter-spacing: -0.023em;"
        >
          {siteConfig.approach.supervision}
        </p>

        <div class="reveal">
          <a href="#contact" class="btn-outline">Записаться на консультацию</a>
        </div>
      </div>

      <!-- Right: Education timeline -->
      <div class="flex flex-col gap-0 reveal">
        <h3
          class="font-serif font-medium text-ink mb-8"
          style="font-size: 22px; letter-spacing: 0; line-height: 1.2;"
        >
          Образование
        </h3>

        <div class="flex flex-col">
          {siteConfig.education.map((item, index) => (
            <div
              class="flex gap-6 pb-8 relative"
              style={index < siteConfig.education.length - 1 ? '' : ''}
            >
              <!-- Timeline line -->
              {index < siteConfig.education.length - 1 && (
                <div
                  class="absolute left-[39px] top-10 bottom-0 w-px bg-warm-taupe"
                  aria-hidden="true"
                ></div>
              )}

              <!-- Year bubble -->
              <div class="flex-shrink-0 flex flex-col items-center gap-2">
                <div
                  class="w-20 h-8 rounded-pill bg-parchment border border-warm-taupe flex items-center justify-center flex-shrink-0"
                >
                  <span
                    class="text-accent font-semibold"
                    style="font-size: 12px; letter-spacing: 0.05em;"
                  >
                    {item.year}
                  </span>
                </div>
              </div>

              <!-- Content -->
              <div class="flex flex-col gap-1 pt-1">
                <p
                  class="font-medium text-ink"
                  style="font-size: 15px; letter-spacing: -0.023em; line-height: 1.3;"
                >
                  {item.institution}
                </p>
                <p
                  class="text-graphite"
                  style="font-size: 13px; letter-spacing: -0.023em; line-height: 1.5;"
                >
                  {item.program}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
